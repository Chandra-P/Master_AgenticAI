CONVENE_MODE=demo
CONVENE_DB_PATH=data/convene.db
CONVENE_API_URL=http://127.0.0.1:8000
# Only needed for live mode; never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PINECONE_API_KEY=
PINECONE_INDEX=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=convene

# Real venue research (separate from synthetic demo planning).
# URL extraction requires OPENAI_API_KEY; automatic discovery also needs Brave.
BRAVE_SEARCH_API_KEY=
CONVENE_RESEARCH_MODEL=gpt-4.1-mini
LANGCHAIN_TRACING_V2=false

# Private planner: PostgreSQL only, separate from the legacy SQLite demo.
# Use a non-superuser role without BYPASSRLS. Never commit actual credentials.
CONVENE_DATABASE_URL=
CONVENE_TEST_DATABASE_URL=
CONVENE_INTAKE_MODEL=gpt-4.1-mini

# Local directory administration only. Do not supply these secrets to public hosting.
CONVENE_DIRECTORY_ADMIN_URL=
CONVENE_TEST_DIRECTORY_ADMIN_URL=

# Legacy tools only; normal planner uses the approved PostgreSQL directory.
CONVENE_ALLOW_WEB_RESEARCH=false
