# Local Ollama; no hosted inference API key required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=embeddinggemma:latest
RAG_ENABLE_RERANKER=0
# Required when a remote proxy connects; optional for loopback-only development.
RAG_BACKEND_TOKEN=
RAG_GENERATION_BUDGET=100
RAG_BACKEND_URL=
