# Copy this file to `.env` and fill in your own credentials.
#   cp .env.demo .env

# OpenAI — used for embeddings (text-embedding-3-small) and chat (gpt-4.1-mini)
# OPENAI_API_KEY=sk-your-openai-api-key

# Pinecone — vector store for the RAG index
PINECONE_API_KEY=your-pinecone-api-key

# Name of your Pinecone index (512-dim vectors, cosine similarity)
PINECONE_INDEX_NAME=your-index-name

# Notebook 1: local models; separate 768-dimensional cosine Pinecone index
PINECONE_LOCAL_INDEX_NAME=shopeasy-local-rag
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen3.5:2b
