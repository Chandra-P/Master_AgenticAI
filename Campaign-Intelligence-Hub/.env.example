# Local defaults; no API key required. Configure via environment variables.
CIH_OLLAMA_URL=http://localhost:11434
CIH_GENERATION_MODEL=llama3.2:3b
CIH_EMBEDDING_MODEL=embeddinggemma
CIH_GENERATION_PROVIDER=ollama
CIH_EMBEDDING_PROVIDER=ollama
CIH_AUTO_INDEX=false
# Hosted deployment: use .streamlit/secrets.example.toml as the administrator template.
