# Server only. Supply via hosting secrets or uvicorn --env-file backend/.env.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PINECONE_API_KEY=
# Existing dense cosine index with 1536 dimensions for text-embedding-3-small.
PINECONE_INDEX_HOST=
CORS_ORIGINS=http://localhost:3000

# Must match the existing Pinecone index dimension. text-embedding-3-small supports reduction.
OPENAI_EMBEDDING_DIMENSIONS=1536
