# Frontend configuration. Only the Supabase URL and publishable/anon key are public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Backend origin including scheme. Never put provider keys in this file.
FASTAPI_BASE_URL=
# Set true on the public service. Missing setup then shows an error, not demo data.
TAGALONG_REQUIRE_CONNECTED=false
