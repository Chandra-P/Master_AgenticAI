# Copy to backend/.env for Python; never commit .env.
MODEL_MODE=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible gateway; omit to use OpenAI directly.
# OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finpilot
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional shared backend service token, not end-user authentication.
# Set the SAME value in both backend and frontend environment files.
FINPILOT_ACCESS_TOKEN=
# Python default is backend/finpilot.db. Docker uses /data/finpilot.db.
# DATABASE_PATH=/absolute/path/finpilot.db
# Next.js server only. Default: http://127.0.0.1:8000
# API_URL=http://127.0.0.1:8000

# Optional post-validation review: off | demo | openai. Default off.
# demo is simulated; openai sends compact financial facts to the API (no raw documents).
COUNCIL_MODE=off
# Exactly three model IDs. Must support JSON-schema structured output.
COUNCIL_MODELS=gpt-4.1-mini,gpt-4.1,gpt-4o
