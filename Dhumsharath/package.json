{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "preinstall": "node ./scripts/preinstall.mjs",
    "test:platform": "node --test scripts/platform.test.mjs",
    "test:config": "node --test scripts/vite-config.test.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "test:security": "pnpm --filter @workspace/braces run test && pnpm audit",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
